# ------------------------------------------------------------
#  Copiá este archivo como .env y completá las keys.
#  El .env está en el .gitignore, no se sube al repo.
# ------------------------------------------------------------

# --- API keys ---
PINECONE_API_KEY=pcsk_...
# Genera los embeddings. La consigna menciona OPENAI_API_KEY; acá la reemplaza
# la de Google. La de Anthropic no sirve: Anthropic no ofrece embeddings.
GOOGLE_API_KEY=AIza...

# ------------------------------------------------------------
#  Pinecone
# ------------------------------------------------------------
INDEX_NAME=httpx-docs
PINECONE_NAMESPACE=httpx-docs

# El plan gratuito (Starter) solo permite AWS us-east-1.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ------------------------------------------------------------
#  Embeddings
# ------------------------------------------------------------
# gemini-embedding-001 da 3072 dimensiones por defecto y admite 1536 o 768.
# La dimensión de un índice de Pinecone no se puede cambiar: si se modifica
# este valor, hay que usar otro INDEX_NAME.
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=1536

# ------------------------------------------------------------
#  Ingesta
# ------------------------------------------------------------
# Tamaño de fragmento en tokens. La consigna sugiere entre 500 y 800.
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Vectores por upsert. La clase recomienda lotes de 100 a 200.
BATCH_SIZE=100

# Fragmentos por llamada a la API de embeddings y pausa entre llamadas. El plan
# gratuito de Google limita cuánto se puede vectorizar por minuto; mandar todo
# junto devuelve 429. Si vuelve a pasar, bajar el lote o subir la pausa.
EMBED_BATCH_SIZE=20
EMBED_PAUSE_SECONDS=15
