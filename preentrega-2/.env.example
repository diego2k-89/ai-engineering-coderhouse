# ------------------------------------------------------------
#  Copiá este archivo como .env y completá las keys.
#  El .env está en el .gitignore, no se sube al repo.
# ------------------------------------------------------------

# --- API keys ---
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
OPENAI_API_KEY=

# --- Proveedor por defecto: openai | anthropic | gemini ---
LLM_PROVIDER=anthropic

# --- Modelos ---
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL=gpt-4o-mini

# --- Generación ---
# temperature=0: para extracción estructurada queremos determinismo.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024

# --- Resiliencia ---
LLM_MAX_RETRIES=3
