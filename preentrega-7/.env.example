# Copiar como .env y completar. El .env no se sube al repo.

# --- Modelo (supervisor, especialistas y síntesis) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Investigador: el índice de la pre-entrega 4 ---
PINECONE_API_KEY=
GOOGLE_API_KEY=
INDEX_NAME=httpx-docs
PINECONE_NAMESPACE=httpx-docs
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=1536

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- LangSmith (observabilidad) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pe7-api-agentes

# --- API ---
# Derivaciones a especialistas antes de pedir aprobación humana.
PRESUPUESTO_DERIVACIONES=2
# Jobs que el worker corre en paralelo.
MAX_CONCURRENCIA=5
# Tiempo máximo de un job antes de pasar a FAILED.
TIMEOUT_JOB_SEGUNDOS=180
