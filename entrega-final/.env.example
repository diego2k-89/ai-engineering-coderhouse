# Copiar como .env y completar las tres keys (y la de LangSmith). El .env no se sube al repo.

# --- Modelo (supervisor, especialistas y síntesis) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Opcional. Vacía no se manda: los modelos más nuevos no aceptan temperature.
ANTHROPIC_TEMPERATURE=

# --- RAG: Pinecone y embeddings de Google ---
PINECONE_API_KEY=
GOOGLE_API_KEY=
INDEX_NAME=httpx-docs
PINECONE_NAMESPACE=httpx-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=1536
RAG_TOP_K=5
RAG_PESO_BM25=0.3
RAG_PESO_VECTORIAL=0.7

# --- Redis ---
# Con docker compose no hace falta: el compose usa redis://redis:6379.
# Para correr la API afuera de Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --- LangSmith (observabilidad) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=entrega-final
PROMPT_VERSION=final-v1

# --- API y worker ---
# Derivaciones a especialistas antes de pedir aprobación humana.
PRESUPUESTO_DERIVACIONES=2
# Jobs que el worker corre en paralelo.
MAX_CONCURRENCIA=5
# Tiempo máximo de un tramo del grafo antes de pasar a FAILED.
TIMEOUT_JOB_SEGUNDOS=180
