# ------------------------------------------------------------
#  Copiá este archivo como .env y completá las keys.
#  El .env está en el .gitignore, no se sube al repo.
# ------------------------------------------------------------

# --- API keys ---
GOOGLE_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
#  Embeddings
# ------------------------------------------------------------
# Cada modelo de embeddings tiene su propio índice en disco, bajo
# vectorstore/<provider>__<modelo>/. Cambiar esto NO rompe el índice
# anterior: se crea uno nuevo al lado y se puede volver atrás.
#
# IMPORTANTE: hay que indexar y consultar con el MISMO modelo. Ese es el
# error #1 de la consigna, y no falla con una excepción: devuelve
# fragmentos al azar. El namespacing por carpeta lo hace imposible.

# google | huggingface
EMBEDDING_PROVIDER=google

GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# Solo si EMBEDDING_PROVIDER=huggingface. Requiere:
#   pip install langchain-huggingface sentence-transformers
# Ojo: sentence-transformers arrastra PyTorch (varios GB).
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------
#  Chunking
# ------------------------------------------------------------
# Medidos en tokens, no en caracteres (usa from_tiktoken_encoder).
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ------------------------------------------------------------
#  Recuperación
# ------------------------------------------------------------
# Entre 3 y 5, como pide la consigna. Más fragmentos no es mejor:
# degradan la atención del modelo ("lost in the middle").
TOP_K=4

# ------------------------------------------------------------
#  Generación
# ------------------------------------------------------------
# anthropic | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024

# ------------------------------------------------------------
#  Varios
# ------------------------------------------------------------
# ChromaDB manda telemetría anónima por defecto.
ANONYMIZED_TELEMETRY=False
