# ------------------------------------------------------------
#  Plantilla de variables de entorno.
#
#  1. Copiá este archivo como .env  (sin el .example)
#  2. Completá los valores reales
#  3. NUNCA commitees el .env  --  ya está en el .gitignore
# ------------------------------------------------------------

# --- Anthropic ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Gemini ---
# https://aistudio.google.com/apikey   (free tier, sin tarjeta)
GOOGLE_API_KEY=AIza...

# --- OpenAI ---
# Dejalo vacío o con un valor inválido a propósito.
# Así simulamos una "caída de proveedor" y se puede ver el fallback funcionando.
OPENAI_API_KEY=

# ------------------------------------------------------------
#  Configuración del cliente
# ------------------------------------------------------------

# Proveedor principal: openai | anthropic | gemini
LLM_PROVIDER=openai

# Cadena de fallback, en orden. Si el principal falla, se prueba el siguiente.
LLM_FALLBACK_CHAIN=anthropic,gemini

# Modelos por proveedor
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-flash-latest

# Parámetros de generación (validados por Pydantic)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# Resiliencia
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30
